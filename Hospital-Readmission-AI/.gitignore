# ===== Environment & secrets =====
.env
.env.*
!.env.example
*.pem
*.key
application.properties
application-*.properties
!application.properties.example
!application-nodb.properties

# ===== Node / Frontend =====
node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Java / Maven =====
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# ===== Python =====
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ===== ML artifacts (large binaries) =====
ml-service/model/*.joblib
ml-service/model/*.pkl
