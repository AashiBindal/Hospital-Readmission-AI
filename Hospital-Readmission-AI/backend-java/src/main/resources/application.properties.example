# =====================================================================
# Hospital-Readmission-AI backend configuration TEMPLATE
# Copy to application.properties (git-ignored) OR set environment
# variables. Values in ${...} are read from the environment with the
# default after the colon. NEVER put real credentials in this file.
# =====================================================================

spring.application.name=hospital-readmission-backend
server.port=${BACKEND_PORT:8080}
server.servlet.context-path=/api

# ---------- SQL Server ----------
spring.datasource.url=jdbc:sqlserver://${DB_HOST:localhost}:${DB_PORT:1433};databaseName=${DB_NAME:HospitalReadmissionDB};encrypt=true;trustServerCertificate=true
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# ---------- JPA ----------
# Schema is owned by database/schema.sql — Hibernate must NOT create tables.
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect

# ---------- Integration ----------
app.ml-service.url=${ML_SERVICE_URL:http://localhost:8000}
app.ml-service.timeout-ms=10000
app.cors.allowed-origins=${FRONTEND_URL:http://localhost:5173}

# ---------- Uploads ----------
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# ---------- Logging ----------
logging.level.com.hospital=DEBUG
