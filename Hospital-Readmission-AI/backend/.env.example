# Copy to backend/.env (git-ignored). Spring Boot reads it via spring.config.import.
# Values are Java-properties syntax: no quotes needed; avoid backslashes (use instanceName=... below).

# ---- SQL Server: existing HospitalReadmissionDB (run database/migrations/002 first) ----
# Named instance (needs the "SQL Server Browser" service running):
DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=HospitalReadmissionDB;encrypt=true;trustServerCertificate=true
# Or a fixed TCP port (SQL Server Configuration Manager -> TCP/IP -> IPAll -> TCP Port):
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=HospitalReadmissionDB;encrypt=true;trustServerCertificate=true
# SQL Server login (recommended for the backend). For Windows authentication instead, append
# ;integratedSecurity=true to DB_URL, leave these empty and install the mssql-jdbc_auth DLL (see README).
DB_USERNAME=
DB_PASSWORD=

# ---- Security (REQUIRED) ----
# At least 32 random characters, e.g. PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
# Frontend origin(s) allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:3000

# ---- Optional: create the first ADMIN once (only if no ADMIN exists), then remove the password ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# ---- ML service (ml-service/, FastAPI) ----
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000

# ---- Uploads + Python ETL (etl/main.py) ----
UPLOAD_DIR=./uploads
# true = run the ETL automatically after each upload
ETL_ENABLED=false
# Python of the ETL's virtual environment, e.g. ../etl/.venv/Scripts/python.exe on Windows
ETL_PYTHON=python
ETL_DIR=../etl
# Full path to IDS_mapping.csv (required when ETL_ENABLED=true); forward slashes work on Windows
ETL_MAPPINGS_FILE=
ETL_TIMEOUT_MINUTES=30

BACKEND_PORT=8080
